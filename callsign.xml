<?xml version="1.0" encoding="UTF-8"?>
<!--
  callsign.xml — Base de datos de distintivos de llamada (callsigns)
  Uso: responder a la instrucción ATC por el distintivo de llamada.
  Formato del callsign en frecuencia:
    CIVIL:    DISTINTIVO + 3 a 4 dígitos   (ej: LXP 1234  →  "LANEX 1234")
    MILITAR:  NOMBRE DE COMBATE + 3 a 4 dígitos (ej: "APACHE 12", "CACIQUE 55")

  FUENTE: ICAO Doc 8585 + base pública de distintivos https://123atc.com/call-signs
  (consulta 2026-10-25, 6.243 distintivos descargados y cruzados uno a uno).
  Regla: el distintivo se escribe TAL CUAL lo publica la base — nunca traducido
  al español ni "españolizado" (KOREANAIR, EMIRATES, AIR CANADA, CATHAY…).

  DIFERENCIAS INTENCIONALES respecto de la base 123atc:
         SKU  = "SKY"   (base 123atc: AEROSKY)
         SWR  = "SWISSAIR"   (base 123atc: SWISS)
         QFA  = "QUANTAS"   (base 123atc: QANTAS)

  DIFERENCIAS INTENCIONALES respecto de la base 123atc:
         SKU  = "SKY"   (base 123atc: AEROSKY)
         SWR  = "SWISSAIR"   (base 123atc: SWISS)
         QFA  = "QUANTAS"   (base 123atc: QANTAS)
-->
