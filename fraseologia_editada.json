  ],

  "lenguaje": {
    "descripcion": "Lenguaje implícito — sinónimos/palabras clave para detectar la INTENCIÓN del controlador (nlpAction). Se combinan con OR. Prefijos cortos cubren variantes: 'gir' → gire/gira/girar. Acentos opcionales: 'patrón' ≡ 'patron'. Editable desde FRASES → LENGUAJE.",
    "acciones": {
      "hdg": ["rumbo", "heading", "hdg", "fly", "vire", "vira", "gir", "turn", "curso", "proa", "steer"],
      "climb": ["sub", "asciend", "ascend", "climb", "trep", "subir", "go up"],
      "descend": ["baj", "desciend", "descend", "descent", "go down"],
      "spd": ["velocidad", "speed", "reduce", "reduzc", "disminu", "slow", "aument", "increase", "nudos", "knots"],
      "direct": ["directo", "diríjase", "dirígete", "direct", "proceed direct", "go direct", "vaya directo", "ve directo", "vaya", "ve a", "go to"],
      "hold": ["espera", "espere", "esperando", "hold", "holding", "patrón de espera"]
    }
  },

  "establecida_referencia": [
    { "categoria": "area", "es": "Área de control {name}", "en": "Airspace {name}" },
    { "categoria": "area", "es": "Cumple con instrucciones de {name}", "en": "Comply with {name} instructions" },
    { "categoria": "approach", "es": "Control de aproximación {name}", "en": "Approach {name}" },
    { "categoria": "approach", "es": "Para {pista}, descendiendo a {nivel}", "en": "For {runway}, descending to {level}" },
    { "categoria": "aerodrome", "es": "Torre de {aeropuerto}", "en": "{airport} Tower" },
    { "categoria": "aerodrome", "es": "Pista {num}, alineación y despegue", "en": "Runway {num}, line up and wait" },
    { "categoria": "coord", "es": "Coordinado con {name}", "en": "Coordination with {name}" },
    { "categoria": "coord", "es": "Tráfico coordinado", "en": "Traffic coordinated" }
  ]
}
